{
  "name": "copilotoffice",
  "version": "2.4.0",
  "description": "A 2D pixel-art desktop game where you walk around a virtual office and interact with AI agents that run real GitHub Copilot CLI sessions — plan, debug, orchestrate fleets, and drive agents from Microsoft Teams.",
  "main": "dist/electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan1510123/CopilotOffice.git"
  },
  "homepage": "https://github.com/dan1510123/CopilotOffice#readme",
  "bugs": {
    "url": "https://github.com/dan1510123/CopilotOffice/issues"
  },
  "bin": {
    "copilotoffice": "bin/copilotoffice.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/index.html"
  ],
  "scripts": {
    "build:game": "esbuild src/main.ts --bundle --outfile=dist/game.bundle.js --platform=browser --format=iife --global-name=CopilotOffice",
    "build:electron": "esbuild electron/main.ts electron/terminal/preload.ts electron/cli-bridge.ts electron/terminal/events-watcher.ts electron/terminal/server.ts electron/terminal/protocol.ts electron/terminal/ipc-relay.ts electron/dataBackup.ts --bundle --outdir=dist/electron --platform=node --format=cjs --external:electron --external:node-pty --external:ws --external:playwright",
    "build": "npm run build:game && npm run build:electron",
    "prepare": "node scripts/setup-hooks.js",
    "hooks:setup": "node scripts/setup-hooks.js",
    "restore-data": "npm run build:electron && node scripts/restore-data.js",
    "prepack": "npm run build",
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run build:game -- --watch\" \"npm run build:electron -- --watch\" \"electron .\"",
    "electron": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test"
  },
  "keywords": [
    "copilot",
    "copilot-cli",
    "ai-agents",
    "game",
    "pixel-art",
    "phaser",
    "electron",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "@github/copilot": "1.0.70"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "electron": "^40.6.1",
    "marked": "^12.0.2",
    "node-pty": "^1.1.0",
    "phaser": "^3.90.0",
    "playwright": "^1.61.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^25.3.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.3",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
